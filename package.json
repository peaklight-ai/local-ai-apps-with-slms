{
  "name": "docsummarizer",
  "version": "0.1.0",
  "private": true,
  "description": "Private document summarizer with local LLMs",
  "scripts": {
    "dev": "pnpm --filter @docsummarizer/desktop dev",
    "dev:mobile": "pnpm --filter @docsummarizer/mobile dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @docsummarizer/desktop build",
    "build:mobile": "pnpm --filter @docsummarizer/mobile build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
